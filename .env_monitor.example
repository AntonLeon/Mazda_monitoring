# Настройки монитора чатов Mazda CX-5.
# Скопируйте в .env_monitor рядом с mazda_monitor.py (или в /etc и укажите MONITOR_ENV_FILE).
# Файл содержит доступы — в репозиторий не попадает, права должны быть 600.

# --- Доступы my.telegram.org → API development tools ---
MONITOR_API_ID=
MONITOR_API_HASH=

# --- Кому присылать уведомления: id или @юзернейм через запятую ---
# id надёжнее (юзернейм может смениться). Мастер должен быть доступен аккаунту.
MONITOR_NOTIFY_USERS=

# --- Что мониторить ---
# Вариант 1: конкретные чаты (по умолчанию 6 из кода: mazdachinacx5, mazda_club_cx5,
# kuruma_kurgan, auto_zakazz25, mazda_forum, bambaleilatop).
# Надёжнее указывать числовые id (-100…) — юзернеймы чатов меняются.
# MONITOR_CHATS=@mazdachinacx5,@mazda_club_cx5
#
# Вариант 2: слушать ВСЕ группы и каналы, в которых состоит аккаунт.
# Новые группы подхватываются сразу, перезапуск не нужен.
# MONITOR_CHATS=all
# Что исключить в режиме all (например, свой чат с мастерами):
# MONITOR_CHATS_EXCLUDE=@mazda_masters,-1001234567890

# --- Порог чувствительности ---
# Вес сообщения считается по правилам в коде: русификация 4, купил/забрал/таможня 3,
# скрытые функции 3, просьба о помощи 3, доработки 2, «из Китая» 1.
# Продавцы, реклама и вакансии отсекаются всегда. Меньше порог — больше уведомлений.
# MONITOR_MIN_SCORE=3

# --- Доставка уведомлений ---
# Если задан токен бота, уведомления уходят от бота (личный аккаунт только слушает):
# так меньше риска ограничений аккаунта. Получателей тогда указывать числовыми id.
# MONITOR_BOT_TOKEN=

# --- Прочее ---
# Файл сессии (по умолчанию mazda_session рядом со скриптом). Права должны быть 600.
# MONITOR_SESSION=/opt/mazda_monitor/mazda_session
# Как часто присылать «монитор жив», минуты (0 — выключено)
# MONITOR_HEARTBEAT_MINUTES=0
# Сколько часов помнить отправленное, чтобы не дублировать (по умолчанию 24)
# MONITOR_SEEN_HOURS=24
# 1 — ничего не отправлять, только писать в лог (удобно для проверки правил)
# MONITOR_DRY_RUN=0
# Файл лога (по умолчанию только вывод в journald)
# MONITOR_LOG_FILE=monitor.log
# Файл памяти об отправленных уведомлениях
# MONITOR_STATE_FILE=monitor_state.json
